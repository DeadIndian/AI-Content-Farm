PORT=8080
TTS_PORT=5002
STORAGE_DIR=./data
DB_PATH=app.db
INPUT_VIDEOS_DIR=./videos
OUTPUT_VIDEOS_DIR=./data/generated

# Cloud models. Keep credentials in ignored .env, never in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE_A=Puck
GEMINI_TTS_VOICE_B=Kore
ALLOW_LOCAL_MODELS=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Presenter Studio: demo/manual modes do not need an AI key.
# AI mode uses Gemini or an explicitly configured compatible cloud API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# STUDIO_PYTHON=.venv/bin/python
# Cloud speech is preferred; choose espeak in the UI for a lightweight no-key demo.
STUDIO_TTS_PROVIDER=gemini
STUDIO_RESOURCE_MODE=gentle
STUDIO_PAUSE_TEMP_C=75
STUDIO_RESUME_TEMP_C=70
STUDIO_CAST_DIR=./data/cast
# Optional Piper voices, used only after explicit ALLOW_LOCAL_MODELS=true.
STUDIO_VOICE_A=en_US-lessac-medium
STUDIO_VOICE_B=en_US-ryan-medium

# Legacy studio speech settings. The primary studio uses STUDIO_TTS_PROVIDER.
TTS_PROVIDER=elevenlabs
TTS_DOCKER_AUTO_MANAGE=false
TTS_DOCKER_SERVICE_NAME=aicf-tts
TTS_DOCKER_PROJECT_DIR=
TTS_BASE_URL=http://localhost:5002
TTS_SYNTH_PATH=/api/tts
TTS_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
FFMPEG_BIN=ffmpeg
PIPER_VOICE=
PIPER_LANGUAGE=
PIPER_QUALITY=

# AutoPilot Configuration
AUTOPILOT_ENABLED=false
AUTOPILOT_EVERY_SECONDS=1800
AUTOPILOT_TOPIC=
AUTOPILOT_PROMPT="Write a high-retention script with a strong hook and punchy ending CTA."
AUTOPILOT_VOICE=

# Podcast Shorts: Gemini cloud transcription, no local model downloads by default.
SHORTS_TRANSCRIBER=gemini
WHISPER_MODEL=base
SHORTS_ENCODER=auto
# CPU/NPU Whisper requires explicit ALLOW_LOCAL_MODELS=true on a capable machine.
# Main container budget: one CPU equivalent, 2 GiB RAM, no container swap.
AICF_CPUS=1.0
AICF_MEMORY=2g
SHORTS_THREADS=1
SHORTS_PAUSE_TEMP_C=75
SHORTS_RESUME_TEMP_C=70
SHORTS_CLIP_REST_SECONDS=5
SHORTS_MIN_FREE_GB=5
SHORTS_KEEP_SOURCE=false
YOUTUBE_DOWNLOAD_RATE=5M
# Optional overrides (run-local.sh sets the Python and yt-dlp virtualenv paths).
# PYTHON_BIN=python3
# YTDLP_BIN=yt-dlp
# SHORTS_SCRIPT=scripts/shorts.py
# FFPROBE_BIN=ffprobe
# Only needed if YouTube asks for sign-in. Browser cookies work with local runs.
# YOUTUBE_COOKIES_BROWSER=firefox
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
