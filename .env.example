PORT=8080
TTS_PORT=5002
STORAGE_DIR=./data
DB_PATH=app.db
INPUT_VIDEOS_DIR=./videos
OUTPUT_VIDEOS_DIR=./data/generated

# LLM Configuration (Gemini Primary, OpenRouter Backup)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

TTS_PROVIDER=piper
TTS_DOCKER_AUTO_MANAGE=false
TTS_DOCKER_SERVICE_NAME=aicf-tts
TTS_DOCKER_PROJECT_DIR=
TTS_BASE_URL=http://localhost:5002
TTS_SYNTH_PATH=/api/tts
TTS_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
FFMPEG_BIN=ffmpeg
PIPER_VOICE=
PIPER_LANGUAGE=
PIPER_QUALITY=

# AutoPilot Configuration
AUTOPILOT_ENABLED=false
AUTOPILOT_EVERY_SECONDS=1800
AUTOPILOT_TOPIC=
AUTOPILOT_PROMPT=Write a high-retention script with a strong hook and punchy ending CTA.
AUTOPILOT_VOICE=

# Podcast Shorts: local CPU int8 transcription, Intel GPU rendering when available.
WHISPER_MODEL=base
SHORTS_ENCODER=auto
# NPU overlay defaults to auto (Intel NPU with CPU fallback); base model supported.
# SHORTS_TRANSCRIBER=auto
# Main container budget: two CPU equivalents, 5 GiB RAM, no container swap.
AICF_CPUS=2.0
AICF_MEMORY=5g
SHORTS_THREADS=2
SHORTS_PAUSE_TEMP_C=80
SHORTS_CLIP_REST_SECONDS=2
SHORTS_MIN_FREE_GB=5
SHORTS_KEEP_SOURCE=false
YOUTUBE_DOWNLOAD_RATE=5M
# Optional overrides (run-local.sh sets the Python and yt-dlp virtualenv paths).
# PYTHON_BIN=python3
# YTDLP_BIN=yt-dlp
# SHORTS_SCRIPT=scripts/shorts.py
# FFPROBE_BIN=ffprobe
# Only needed if YouTube asks for sign-in. Browser cookies work with local runs.
# YOUTUBE_COOKIES_BROWSER=firefox
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
